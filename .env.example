# cppchain 环境变量模板 —— 复制为 .env 并填入真实值（.env 已被 git 忽略）
#
# 用途：examples/chat_live 等需要真实端点的 demo 从这里读取配置。
# 代码只从环境变量读取，密钥永不出现在源码与提交里。

# OpenAI 兼容端点的密钥
LLM_API_KEY=sk-your-key-here

# OpenAI 兼容端点地址（DeepSeek / OpenAI / Ollama / vLLM ...）
LLM_BASE_URL=https://api.deepseek.com/v1

# 协议格式（当前只支持 openai 兼容）
LLM_API_FORMAT=openai

# 默认模型名
LLM_MODEL=deepseek-chat

# 网络搜索工具（src/tool/web_search.cpp，feedcoop Bearer）。
# 未配置时 workflow 编译可通过（工具名在注册表里），运行到搜索调用才报错。
WEB_SEARCH_API_KEY=

# 向量（embedding）端点 —— 用于语义检索（工具检索/记忆检索/RAG）
#   阿里云 MaaS / DashScope 原生格式（非 OpenAI 格式）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://llm-lutpf7n65chtxe48.cn-beijing.maas.aliyuncs.com
EMBEDDING_MODEL=qwen3.7-text-embedding

# 可选：企业代理/自签证书环境的 CA bundle 路径
#   （本机若存在 ~/.geo/corp-ca.pem 会自动启用，无需设置）
# LLM_CA_BUNDLE=/path/to/corp-ca.pem

# 联网搜索工具（feedcoop global search，Bearer key，返回原始文档列表）—— live_tools / research_chat 用
# 参考 simple-agent 的 handle_web_search：POST {WEB_SEARCH_BASE_URL}，请求体 {query, doc_count,
# max_snippet_length, max_image_count_per_doc}；响应 Result.Documents[]（Title/Url/Hostname/发布时间/摘要）。
# WEB_SEARCH_API_KEY=<feedcoop 搜索 API Key>
# WEB_SEARCH_BASE_URL=https://open.feedcoopapi.com/search_api/global_search
