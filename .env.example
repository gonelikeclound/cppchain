# cppchain 环境变量模板 —— 复制为 .env 并填入真实值（.env 已被 git 忽略）
#
# 用途：examples/chat_live 等需要真实端点的 demo 从这里读取配置。
# 代码只从环境变量读取，密钥永不出现在源码与提交里。

# OpenAI 兼容端点的密钥
LLM_API_KEY=sk-your-key-here

# OpenAI 兼容端点地址（DeepSeek / OpenAI / Ollama / vLLM ...）
LLM_BASE_URL=https://api.deepseek.com/v1

# 协议格式（当前只支持 openai 兼容）
LLM_API_FORMAT=openai

# 默认模型名
LLM_MODEL=deepseek-chat

# 向量（embedding）端点 —— 用于语义检索（工具检索/记忆检索/RAG）
#   阿里云 MaaS / DashScope 原生格式（非 OpenAI 格式）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://llm-lutpf7n65chtxe48.cn-beijing.maas.aliyuncs.com
EMBEDDING_MODEL=qwen3.7-text-embedding

# 可选：企业代理/自签证书环境的 CA bundle 路径
#   （本机若存在 ~/.geo/corp-ca.pem 会自动启用，无需设置）
# LLM_CA_BUNDLE=/path/to/corp-ca.pem

# 联网搜索工具（火山方舟 Responses API · web_search，豆包来源）—— live_tools demo 用
#   注意：这是火山方舟 API Key（UUID 格式），不是 LLM_API_KEY 那种 sk- 密钥。
#   若鉴权报 "API key format is incorrect"，说明填成了别的格式，请在方舟控制台重新创建。
# WEB_SEARCH_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# WEB_SEARCH_BASE_URL=https://ark.cn-beijing.volces.com
# WEB_SEARCH_PATH=/api/v3/responses
# WEB_SEARCH_MODEL=doubao-seed-2-1-pro-260628
