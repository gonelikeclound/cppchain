{
  "id": "pev_l3",
  "nodes": [
    { "id": "recall", "kind": "load_history",
      "path": "@config.workspace", "session": "@config.session", "next": "plan" },
    { "id": "plan", "kind": "plan",
      "goal": "@config.goal",
      "default_plan": {
        "steps": [
          { "id": "s1",
            "goal": "用 get_weather 查北京今天天气，如果有结论就记住温度范围",
            "deps": [] },
          { "id": "s2",
            "goal": "综合前面查到的数据，用一句话给出北京今天的天气结论",
            "deps": ["s1"],
            "verify": { "kind": "model",
                        "criteria": "结论基于前面查到的真实温度数据、有明确数字、简练" } }
        ]
      },
      "next": "loop" },
    { "id": "loop", "kind": "loop", "max": 2, "next": "final", "on_max": "final",
      "body": [
        { "id": "step",   "kind": "verify", "phase": "announce", "next": "think" },
        { "id": "think",  "kind": "model", "model": "main", "tools": "chat",
          "system_prompt": "你是任务执行助手：按每一步的具体指令行事；查天气用 get_weather，查信息用 web_search，写文件用 file_write。",
          "next": "route" },
        { "id": "route", "kind": "route", "on": "last_ai_outcome",
          "cases": { "tool_calls": "act", "text": "judge", "invalid_tool_calls": "_fail" },
          "default": "_fail" },
        { "id": "act", "kind": "run_tools", "next": "judge" },
        { "id": "judge", "kind": "verify", "phase": "judge", "model": "main",
          "next": "_continue" }
      ] },
    { "id": "final", "kind": "model", "model": "main",
      "system_prompt": "整合任务的步骤结论，给出最终回答（简洁、直接、有依据）。",
      "next": "_turn_end" }
  ]
}