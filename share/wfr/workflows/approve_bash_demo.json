{
  "id": "approve_bash_demo",
  "nodes": [
    { "id": "recall", "kind": "load_history",
      "path": "@config.workspace", "session": "@config.session", "next": "loop" },
    { "id": "loop", "kind": "loop", "max": 3, "next": "_turn_end",
      "body": [
        { "id": "think", "kind": "model", "model": "main", "tools": "chat_bash",
          "system_prompt": "你是 bash 审批演示助手：能用 bash 完成的就调 bash（运行只读命令如 ls/echo 可直接跑；写/危险命令也会请求审批——那正是演示点）；写文件用 file_write；回答时如实报告工具结果，被拒绝就说明被拒绝。",
          "next": "route" },
        { "id": "route", "kind": "route", "on": "last_ai_outcome",
          "cases": { "tool_calls": "approve", "invalid_tool_calls": "_fail", "text": "_turn_end" },
          "default": "_fail" },
        { "id": "approve", "kind": "approve_tools",
          "deny": [],
          "next": "act" },
        { "id": "act", "kind": "run_tools", "next": "echo_tool" },
        { "id": "echo_tool", "kind": "echo",
          "text": "🔧 $act.result.summary", "next": "_continue" }
      ] }
  ]
}