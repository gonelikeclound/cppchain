{
  "id": "builtin_chat",
  "nodes": [
    { "id": "recall", "kind": "load_history",
      "path": "@config.workspace", "session": "@config.session", "next": "loop" },
    { "id": "loop", "kind": "loop", "max": 4, "next": "_turn_end",
      "body": [
        { "id": "think", "kind": "model", "model": "main", "tools": "chat",
          "system_prompt": "你是 wfr 的智能助手，多轮续聊、回答简短直接。必要时调用工具再回答：天气用 get_weather（参数 city），网络信息用 web_search（参数 query）；回答给出的数值与工具结果一致，不要编造工具没有给出的数据。",
          "next": "echo_think" },
        { "id": "echo_think", "kind": "echo",
          "text": "💭 $think.result.thinking", "next": "route" },
        { "id": "route", "kind": "route", "on": "last_ai_outcome",
          "cases": { "tool_calls": "act", "invalid_tool_calls": "_fail", "text": "_turn_end" },
          "default": "_fail" },
        { "id": "act", "kind": "run_tools", "next": "echo_tool" },
        { "id": "echo_tool", "kind": "echo",
          "text": "🔧 $act.result.summary", "next": "_continue" }
      ] }
  ]
}
