# 构建产物
build/
cmake-build-*/

# demo 运行产物（examples/ 落盘演示写到此处）
demo-out/

# wfr 默认临时工作区（wfr.sh；session/checkpoint/debug 产物都在这里）
tmp/

# webui 测试报告快照（./run-tests-report.sh 生成，运行态非源码；git 不跟踪）
web/tests_report.json
# run-webui.sh 启动时创建的 symlink（指向 build 产物，运行态不入库）
web/cgi-bin/
web/wfr_bin

# 密钥与本地环境配置 —— 绝不入库
.env
.env.*
!.env.example
*.local

# 编译中间物
*.o
*.a
*.so
*.so.*
*.lo
*.lib
*.obj
*.exe
*.dll

# CMake
CMakeUserPresets.json
compile_commands.json

# 编辑器/系统
.vscode/
.idea/
*.swp
*~
.DS_Store

# 本地工具链缓存(若克隆到别的环境)
/opt_cache/
# A2：submit_result 偶发把 verdict 写进程 CWD 的 .out（防误入版本库）
/.out/
office-docs/.out/
life.jsonl

# C++ Agent 演讲专题（talk-cxx-agent/ 单独目录，讨论/修改历史供查阅，不进 commit）
talk-cxx-agent/

# 42 文档以云端为准，本地不推送
docs/04-problems/42-副作用·防重放·防环·结果可信·可回溯·可恢复*
