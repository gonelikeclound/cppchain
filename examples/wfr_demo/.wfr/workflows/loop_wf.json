{
  "id": "loop_wf",
  "import": { "workflow": "notify_wf" },
  "nodes": [
    { "id": "loop", "kind": "loop", "max": 3, "next": "n", "on_max": "_turn_end",
      "body": [
        { "id": "poll", "tool": "fetch_price",
          "parameters": {"item_id": "P1"},
          "output_schema": {"price": "number", "in_stock": "boolean"},
          "next": "ck" },
        { "id": "ck", "expr": "$poll.result.price < 500",
          "then": "_break", "else": "_continue" }
      ] }
  ]
}
